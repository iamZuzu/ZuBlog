# Copy this file to .env.local for local development, and set the same
# two values in your host's environment variables (e.g. Netlify > Site
# settings > Environment variables) so they're baked in at build time.
#
# Get these from your PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
