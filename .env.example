# Copy this file to .env.local for local development, and set the same
# two values in your host's environment variables (e.g. Netlify > Site
# settings > Environment variables) so they're baked in at build time.
#
# Get these from your PostHog project settings. If NEXT_PUBLIC_POSTHOG_KEY
# is left unset, analytics is simply skipped — nothing breaks.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Visitor comments via giscus (https://giscus.app), which stores comments
# as GitHub Discussions on your repo. If any of these four are left unset,
# the comments section is simply skipped — nothing breaks.
#
# Setup: enable Discussions on your GitHub repo (Settings > General >
# Features > Discussions), then go to https://giscus.app, fill in your
# repo, and copy the four data-* values it generates into these:
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
